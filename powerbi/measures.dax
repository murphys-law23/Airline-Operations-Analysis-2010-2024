// Create each measure separately on FactFlights.
Scheduled Flights = SUM(FactFlights[flights])
Eligible Arrivals = SUM(FactFlights[eligible])
Delayed Arrivals = SUM(FactFlights[delayed])
On Time Arrivals = [Eligible Arrivals] - [Delayed Arrivals]
Arrival Delay Rate = DIVIDE([Delayed Arrivals],[Eligible Arrivals])
On Time Rate = DIVIDE([On Time Arrivals],[Eligible Arrivals])
Cancelled Flights = SUM(FactFlights[cancelled])
Cancellation Rate = DIVIDE([Cancelled Flights],[Scheduled Flights])
Diverted Flights = SUM(FactFlights[diverted])
Severe Delay Rate = DIVIDE(SUM(FactFlights[severe]),[Eligible Arrivals])
Average Late Arrival Minutes = DIVIDE(SUM(FactFlights[delay_minutes]),[Delayed Arrivals])
Airports In Scope = DISTINCTCOUNT(FactFlights[airport])
Flights Previous Year = CALCULATE([Scheduled Flights],DATEADD(Calendar[Date],-1,YEAR))
Flights YoY Change = DIVIDE([Scheduled Flights]-[Flights Previous Year],[Flights Previous Year])
Delay Rate Previous Year = CALCULATE([Arrival Delay Rate],DATEADD(Calendar[Date],-1,YEAR))
Delay Change Percentage Points = IF(NOT ISBLANK([Delay Rate Previous Year]),100*([Arrival Delay Rate]-[Delay Rate Previous Year]))
Rolling 12 Month Delay Rate =
VAR LastDate = MAX(Calendar[Date])
VAR Window = DATESINPERIOD(Calendar[Date],LastDate,-12,MONTH)
RETURN IF(LastDate>=DATE(2010,12,31),DIVIDE(CALCULATE([Delayed Arrivals],Window),CALCULATE([Eligible Arrivals],Window)))
Air Carrier Minutes = SUM(FactFlights[carrier_minutes])
Weather Minutes = SUM(FactFlights[weather_minutes])
NAS Minutes = SUM(FactFlights[nas_minutes])
Security Minutes = SUM(FactFlights[security_minutes])
Late Aircraft Minutes = SUM(FactFlights[late_aircraft_minutes])
Attributed Delay Minutes = [Air Carrier Minutes]+[Weather Minutes]+[NAS Minutes]+[Security Minutes]+[Late Aircraft Minutes]
Selected Cause Minutes = SWITCH(SELECTEDVALUE(DelayCauses[Cause]),"Air carrier",[Air Carrier Minutes],"Extreme weather",[Weather Minutes],"National aviation system",[NAS Minutes],"Security",[Security Minutes],"Late aircraft",[Late Aircraft Minutes])
Selected Cause Share = DIVIDE([Selected Cause Minutes],[Attributed Delay Minutes])
Airport Map Colour = SWITCH(TRUE(),ISBLANK([Arrival Delay Rate]),"#B7C5D0",[Arrival Delay Rate]<0.15,"#2C70AB",[Arrival Delay Rate]<0.25,"#D29536","#BF5748")
