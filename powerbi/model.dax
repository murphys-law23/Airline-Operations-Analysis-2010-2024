// Create each calculated table separately.
Calendar = ADDCOLUMNS(CALENDAR(DATE(2010,1,1),DATE(2024,12,31)),"Year",YEAR([Date]),"MonthNumber",MONTH([Date]),"Month",FORMAT([Date],"mmm"),"YearMonth",FORMAT([Date],"yyyy-MM"))
DelayCauses = DATATABLE("Cause",STRING,{{"Air carrier"},{"Extreme weather"},{"National aviation system"},{"Security"},{"Late aircraft"}})
// Single-direction 1:* relationships:
// Calendar[Date] -> FactFlights[Month Start]
// Airports[airport] -> FactFlights[airport]
// Carriers[carrier_id] -> FactFlights[carrier_id]
// DelayCauses is disconnected. Mark Calendar as date table; sort Month by MonthNumber.
